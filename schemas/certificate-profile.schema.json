{
  "$schema" : "https://json-schema.org/draft/2020-12/schema",
  "$defs" : {
    "AccessDescriptionConfig" : {
      "type" : "object",
      "properties" : {
        "access_location" : {
          "$ref" : "#/$defs/GeneralNameConfig",
          "description" : "Location where the authority information can be accessed"
        },
        "access_method" : {
          "type" : "string",
          "description" : "Access method for authority information",
          "enum" : [ "ocsp", "caIssuers", "timeStamping" ],
          "minLength" : 1
        }
      },
      "description" : "Access description configuration for authority information access"
    },
    "DistributionPointConfig" : {
      "type" : "object",
      "properties" : {
        "full_name" : {
          "description" : "Full name of the CRL distribution point",
          "type" : "array",
          "items" : {
            "$ref" : "#/$defs/GeneralNameConfig"
          }
        },
        "reasons" : {
          "description" : "Reasons for certificate revocation",
          "type" : "array",
          "items" : {
            "type" : "string",
            "enum" : [ "keyCompromise", "caCompromise", "affiliationChanged", "superseded", "cessationOfOperation", "certificateHold", "privilegeWithdrawn", "aACompromise" ]
          }
        }
      },
      "description" : "Individual CRL distribution point configuration"
    },
    "ExtensionConfig" : {
      "type" : "object",
      "properties" : {
        "critical" : {
          "type" : "boolean",
          "description" : "Whether the extension is marked as critical",
          "default" : false
        },
        "enabled" : {
          "type" : "boolean",
          "description" : "Whether the extension is enabled",
          "default" : true
        }
      },
      "description" : "Base configuration for certificate extensions"
    },
    "GeneralNameConfig" : {
      "type" : "object",
      "properties" : {
        "type" : {
          "type" : "string",
          "description" : "Type of the general name",
          "enum" : [ "uri", "dNSName", "iPAddress", "directoryName", "ediPartyName", "uniformResourceIdentifier", "registeredID" ],
          "minLength" : 1
        },
        "value" : {
          "type" : "string",
          "description" : "Value of the general name",
          "minLength" : 1
        }
      },
      "description" : "General name configuration for various certificate extensions"
    },
    "SubjectFieldValidation" : {
      "type" : "object",
      "properties" : {
        "constraints" : {
          "allOf" : [ {
            "type" : "object",
            "properties" : {
              "domain_names" : {
                "description" : "Domain name constraints (for domain-name type)",
                "type" : "array",
                "items" : {
                  "type" : "object",
                  "properties" : {
                    "allow_wildchars" : {
                      "type" : "boolean",
                      "description" : "Whether wildcard characters are allowed in domain names",
                      "default" : false
                    },
                    "domain_name" : {
                      "type" : "string",
                      "description" : "Required domain suffix",
                      "minLength" : 1
                    }
                  },
                  "description" : "Domain name constraint configuration for domain validation"
                }
              },
              "email_domains" : {
                "description" : "Allowed email domains (for email type)",
                "type" : "array",
                "items" : {
                  "type" : "string"
                }
              },
              "list_values" : {
                "description" : "List of allowed values (for in-list type)",
                "type" : "array",
                "items" : {
                  "type" : "string"
                }
              },
              "max_length" : {
                "type" : "integer",
                "description" : "Maximum string length (for text/email types)"
              },
              "max_value" : {
                "type" : "integer",
                "description" : "Maximum integer value (for integer type)"
              },
              "min_length" : {
                "type" : "integer",
                "description" : "Minimum string length (for text/email types)"
              },
              "min_value" : {
                "type" : "integer",
                "description" : "Minimum integer value (for integer type)"
              },
              "only_ipv4" : {
                "type" : "boolean",
                "description" : "Only allow IPv4 addresses (for ip-address type)",
                "default" : false
              },
              "only_ipv6" : {
                "type" : "boolean",
                "description" : "Only allow IPv6 addresses (for ip-address type)",
                "default" : false
              },
              "pattern" : {
                "type" : "string",
                "description" : "Regular expression pattern (for regex type)"
              },
              "type" : {
                "type" : "string",
                "description" : "Type of constraint validation",
                "enum" : [ "integer", "text", "email", "url", "domain-name", "ip-address", "in-list", "regex" ]
              }
            },
            "description" : "Field validation constraint configuration"
          }, {
            "description" : "Validation constraints for this field"
          } ]
        },
        "description" : {
          "type" : "string",
          "description" : "Detailed description of this field's purpose and usage (maximum 1024 characters)",
          "maxLength" : 1024
        },
        "display_name" : {
          "type" : "string",
          "description" : "Human-readable display name for this field (maximum 256 characters)",
          "maxLength" : 256
        },
        "example" : {
          "type" : "string",
          "description" : "Example value for this field (maximum 512 characters)",
          "maxLength" : 512
        },
        "max" : {
          "type" : "integer",
          "description" : "Maximum number of occurrences (minimum 1)",
          "default" : 1,
          "minimum" : 1
        },
        "min" : {
          "type" : "integer",
          "description" : "Minimum number of occurrences (minimum 1)",
          "default" : 1,
          "minimum" : 1
        },
        "required" : {
          "type" : "boolean",
          "description" : "Whether the field is required",
          "default" : false
        },
        "value" : {
          "type" : "string",
          "description" : "Fixed value for this field (maximum 512 characters)",
          "maxLength" : 512
        }
      },
      "description" : "Configuration for subject field validation and constraints"
    },
    "SubtreeConfig" : {
      "type" : "object",
      "properties" : {
        "type" : {
          "type" : "string",
          "description" : "Type of the subtree constraint",
          "enum" : [ "dNSName", "iPAddress", "directoryName", "ediPartyName", "uniformResourceIdentifier", "registeredID" ],
          "minLength" : 1
        },
        "value" : {
          "type" : "string",
          "description" : "Value of the subtree constraint",
          "minLength" : 1
        }
      },
      "description" : "Subtree configuration for name constraints"
    }
  },
  "type" : "object",
  "properties" : {
    "authority_information_access" : {
      "type" : "object",
      "properties" : {
        "access_descriptions" : {
          "description" : "List of access descriptions for authority information",
          "type" : "array",
          "items" : {
            "$ref" : "#/$defs/AccessDescriptionConfig"
          }
        },
        "critical" : {
          "type" : "boolean",
          "description" : "Whether the extension is marked as critical",
          "default" : false
        },
        "enabled" : {
          "type" : "boolean",
          "description" : "Whether the extension is enabled",
          "default" : true
        }
      },
      "description" : "Authority information access extension configuration"
    },
    "authority_key_identifier" : {
      "$ref" : "#/$defs/ExtensionConfig",
      "description" : "Authority key identifier extension configuration"
    },
    "basic_constraints" : {
      "type" : "object",
      "properties" : {
        "ca" : {
          "type" : "boolean",
          "description" : "Whether this certificate is a CA certificate",
          "default" : false
        },
        "critical" : {
          "type" : "boolean",
          "description" : "Whether the extension is marked as critical",
          "default" : false
        },
        "enabled" : {
          "type" : "boolean",
          "description" : "Whether the extension is enabled",
          "default" : true
        },
        "path_length" : {
          "type" : "integer",
          "description" : "Maximum number of non-self-issued intermediate certificates that may follow this certificate in a valid certification path (minimum 0)",
          "minimum" : 0
        }
      },
      "description" : "Basic constraints extension configuration"
    },
    "ca" : {
      "type" : "string",
      "description" : "Certificate Authority identifier for issuing certificates (maximum 256 characters)",
      "maxLength" : 256
    },
    "certificate_policies" : {
      "type" : "object",
      "properties" : {
        "critical" : {
          "type" : "boolean",
          "description" : "Whether the extension is marked as critical",
          "default" : false
        },
        "enabled" : {
          "type" : "boolean",
          "description" : "Whether the extension is enabled",
          "default" : true
        },
        "policies" : {
          "description" : "List of certificate policies",
          "type" : "array",
          "items" : {
            "type" : "object",
            "properties" : {
              "policy_identifier" : {
                "type" : "string",
                "description" : "Policy identifier in OID format (dot-separated numeric format)",
                "minLength" : 1
              },
              "policy_qualifiers" : {
                "description" : "List of policy qualifiers for this policy",
                "type" : "array",
                "items" : {
                  "type" : "object",
                  "properties" : {
                    "notice_text" : {
                      "type" : "string",
                      "description" : "User notice text (for UserNotice qualifier type)"
                    },
                    "qualifier" : {
                      "type" : "string",
                      "description" : "Policy qualifier value (CPS URI for CPS type)"
                    },
                    "qualifier_type" : {
                      "type" : "string",
                      "description" : "Type of policy qualifier",
                      "enum" : [ "CPS", "UserNotice" ]
                    }
                  },
                  "description" : "Policy qualifier configuration"
                }
              }
            },
            "description" : "Individual certificate policy configuration"
          }
        }
      },
      "description" : "Certificate policies extension configuration"
    },
    "crl_distribution_points" : {
      "type" : "object",
      "properties" : {
        "critical" : {
          "type" : "boolean",
          "description" : "Whether the extension is marked as critical",
          "default" : false
        },
        "distribution_points" : {
          "description" : "List of CRL distribution points",
          "type" : "array",
          "items" : {
            "$ref" : "#/$defs/DistributionPointConfig"
          }
        },
        "enabled" : {
          "type" : "boolean",
          "description" : "Whether the extension is enabled",
          "default" : true
        }
      },
      "description" : "CRL distribution points extension configuration"
    },
    "crypto_policy" : {
      "type" : "string",
      "description" : "Cryptographic policy to apply for certificate generation (maximum 256 characters)",
      "maxLength" : 256
    },
    "custom_extensions" : {
      "description" : "List of custom certificate extensions",
      "type" : "array",
      "items" : {
        "type" : "object",
        "properties" : {
          "attribute" : {
            "type" : "string",
            "description" : "Attribute name (for attribute type extensions)"
          },
          "critical" : {
            "type" : "boolean",
            "description" : "Whether the extension is critical",
            "default" : false
          },
          "data" : {
            "type" : "string",
            "description" : "Extension data (for fixed type extensions)"
          },
          "display_name" : {
            "type" : "string",
            "description" : "Human-readable display name for the extension (maximum 256 characters)",
            "maxLength" : 256
          },
          "encoding" : {
            "type" : "string",
            "description" : "DER encoding type for the extension value",
            "default" : "DEROBJECT",
            "enum" : [ "DERBITSTRING", "DERINTEGER", "DEROCTETSTRING", "DERBOOLEAN", "DERPRINTABLESTRING", "DERUTF8STRING", "DERIA5STRING", "DERNULL", "DEROBJECT", "DEROBJECTIDENTIFIER", "RAW" ]
          },
          "oid" : {
            "type" : "string",
            "description" : "Object identifier for the custom extension (dot-separated numeric format)",
            "minLength" : 1
          },
          "type" : {
            "type" : "string",
            "description" : "Type of custom extension",
            "enum" : [ "fixed", "attribute" ],
            "minLength" : 1
          }
        },
        "description" : "Custom extension configuration for adding non-standard certificate extensions"
      }
    },
    "display_name" : {
      "type" : [ "string", "null" ],
      "title" : "Display Name",
      "description" : "Human-readable display name for UI presentation. If not provided, the name field serves as fallback."
    },
    "extended_key_usage" : {
      "type" : "object",
      "properties" : {
        "critical" : {
          "type" : "boolean",
          "description" : "Whether the extension is marked as critical",
          "default" : false
        },
        "enabled" : {
          "type" : "boolean",
          "description" : "Whether the extension is enabled",
          "default" : true
        },
        "purposes" : {
          "description" : "List of extended key usage purposes (named purposes or OID format)",
          "type" : "array",
          "items" : {
            "type" : "string"
          }
        }
      },
      "description" : "Extended key usage extension configuration"
    },
    "extends" : {
      "title" : "Inheritance Specification",
      "description" : "Specifies parent configurations to inherit from. Can be a single configuration name (string) for single inheritance, or an array of names for multiple inheritance. Parent configurations are merged in order, with later ones taking precedence.",
      "oneOf" : [ {
        "type" : "string"
      }, {
        "type" : "array",
        "items" : {
          "type" : "string"
        }
      } ]
    },
    "freshest_crl" : {
      "type" : "object",
      "properties" : {
        "critical" : {
          "type" : "boolean",
          "description" : "Whether the extension is marked as critical",
          "default" : false
        },
        "distribution_points" : {
          "description" : "List of delta CRL distribution points",
          "type" : "array",
          "items" : {
            "$ref" : "#/$defs/DistributionPointConfig"
          }
        },
        "enabled" : {
          "type" : "boolean",
          "description" : "Whether the extension is enabled",
          "default" : true
        }
      },
      "description" : "Freshest CRL extension configuration (delta CRL distribution points)"
    },
    "inhibit_any_policy" : {
      "type" : "object",
      "properties" : {
        "critical" : {
          "type" : "boolean",
          "description" : "Whether the extension is marked as critical",
          "default" : false
        },
        "enabled" : {
          "type" : "boolean",
          "description" : "Whether the extension is enabled",
          "default" : true
        },
        "skip_certs" : {
          "type" : "integer",
          "description" : "Number of additional certificates that may appear in the path before the anyPolicy OID should be processed (minimum 0)",
          "minimum" : 0
        }
      },
      "description" : "Inhibit any policy extension configuration"
    },
    "issuer_alternative_name" : {
      "$ref" : "#/$defs/ExtensionConfig",
      "description" : "Issuer alternative name extension configuration"
    },
    "key_usage" : {
      "type" : "object",
      "properties" : {
        "critical" : {
          "type" : "boolean",
          "description" : "Whether the extension is marked as critical",
          "default" : false
        },
        "enabled" : {
          "type" : "boolean",
          "description" : "Whether the extension is enabled",
          "default" : true
        },
        "purposes" : {
          "description" : "List of key usage purposes",
          "type" : "array",
          "items" : {
            "type" : "string",
            "enum" : [ "digital_signature", "non_repudiation", "key_encipherment", "data_encipherment", "key_agreement", "key_cert_sign", "crl_sign", "encipher_only", "decipher_only" ]
          }
        }
      },
      "description" : "Key usage extension configuration"
    },
    "name" : {
      "type" : "string",
      "title" : "Configuration Name",
      "description" : "Unique identifier for the configuration object. Must contain only alphanumeric characters, hyphens, and underscores.",
      "minLength" : 1,
      "maxLength" : 256,
      "pattern" : "^[a-zA-Z0-9_-]+$"
    },
    "name_constraints" : {
      "allOf" : [ {
        "type" : "object",
        "properties" : {
          "critical" : {
            "type" : "boolean",
            "description" : "Whether the extension is marked as critical",
            "default" : false
          },
          "enabled" : {
            "type" : "boolean",
            "description" : "Whether the extension is enabled",
            "default" : true
          },
          "excluded_subtrees" : {
            "description" : "List of excluded subtrees for name constraints",
            "type" : "array",
            "items" : {
              "$ref" : "#/$defs/SubtreeConfig"
            }
          },
          "permitted_subtrees" : {
            "description" : "List of permitted subtrees for name constraints",
            "type" : "array",
            "items" : {
              "$ref" : "#/$defs/SubtreeConfig"
            }
          }
        },
        "description" : "Name constraints extension configuration for defining permitted and excluded subtrees"
      }, {
        "description" : "Name constraints extension configuration"
      } ]
    },
    "policy_constraints" : {
      "type" : "object",
      "properties" : {
        "critical" : {
          "type" : "boolean",
          "description" : "Whether the extension is marked as critical",
          "default" : false
        },
        "enabled" : {
          "type" : "boolean",
          "description" : "Whether the extension is enabled",
          "default" : true
        },
        "inhibit_policy_mapping" : {
          "type" : "integer",
          "description" : "Number of additional certificates that may appear in the path before policy mapping is no longer permitted (minimum 0)",
          "minimum" : 0
        },
        "require_explicit_policy" : {
          "type" : "integer",
          "description" : "Number of additional certificates that may appear in the path before an explicit policy is required (minimum 0)",
          "minimum" : 0
        }
      },
      "description" : "Policy constraints extension configuration"
    },
    "policy_mappings" : {
      "type" : "object",
      "properties" : {
        "critical" : {
          "type" : "boolean",
          "description" : "Whether the extension is marked as critical",
          "default" : false
        },
        "enabled" : {
          "type" : "boolean",
          "description" : "Whether the extension is enabled",
          "default" : true
        },
        "mappings" : {
          "description" : "List of policy mappings",
          "type" : "array",
          "items" : {
            "type" : "object",
            "properties" : {
              "issuer_domain_policy" : {
                "type" : "string",
                "description" : "Issuer domain policy OID (dot-separated numeric format)"
              },
              "subject_domain_policy" : {
                "type" : "string",
                "description" : "Subject domain policy OID (dot-separated numeric format)"
              }
            },
            "description" : "Individual policy mapping configuration"
          }
        }
      },
      "description" : "Policy mappings extension configuration"
    },
    "resource_mapping" : {
      "type" : "string",
      "description" : "Resource mapping identifier for this certificate profile (maximum 256 characters)",
      "default" : "none",
      "maxLength" : 256
    },
    "serial_number" : {
      "type" : "object",
      "properties" : {
        "length" : {
          "type" : "integer",
          "description" : "Length of the serial number in bytes (1-20)",
          "default" : 16,
          "minimum" : 1,
          "maximum" : 20
        }
      },
      "description" : "Serial number configuration for certificates"
    },
    "signature_algorithm" : {
      "type" : "string",
      "description" : "Signature algorithm for certificate signing. Case-insensitive validation.",
      "enum" : [ "MD2withRSA", "MD4withRSA", "MD5withRSA", "SHA1withRSA", "RS1", "RIPEMD160withRSA", "RIPEMD128withRSA", "RIPEMD256withRSA", "SHA224withRSA", "SHA3-224withRSA", "SHA3-256withRSA", "SHA3-384withRSA", "SHA3-512withRSA", "SHA256withRSA", "RS256", "SHA384withRSA", "RS384", "SHA512withRSA", "RS512", "SHA256withRSAandMGF1", "PS256", "SHA384withRSAandMGF1", "PS384", "SHA512withRSAandMGF1", "PS512", "SHA1withDSA", "SHA224withDSA", "SHA3-224withDSA", "SHA3-256withDSA", "SHA3-384withDSA", "SHA3-512withDSA", "SHA256withDSA", "SHA384withDSA", "SHA512withDSA", "SHA1withECDSA", "SHA224withECDSA", "SHA3-224withECDSA", "SHA3-256withECDSA", "SHA3-384withECDSA", "SHA3-512withECDSA", "SHA256withECDSA", "ES256", "SHA384withECDSA", "ES384", "SHA512withECDSA", "ES512", "Ed25519", "Ed448", "LMS", "HSS", "GOST3411withGOST3410", "GOST3411withECGOST3410", "SHA1withRSA/ISO9796-2", "MD5andSHA1withRSA", "RIPEMD160withECDSA", "RIPEMD256withECDSA", "WHIRLPOOLwithRSA", "WHIRLPOOLwithECDSA" ]
    },
    "subject" : {
      "allOf" : [ {
        "type" : "object",
        "properties" : {
          "business_category" : {
            "$ref" : "#/$defs/SubjectFieldValidation",
            "description" : "Business Category"
          },
          "common_name" : {
            "$ref" : "#/$defs/SubjectFieldValidation",
            "description" : "Common Name"
          },
          "country" : {
            "$ref" : "#/$defs/SubjectFieldValidation",
            "description" : "Country"
          },
          "description" : {
            "$ref" : "#/$defs/SubjectFieldValidation",
            "description" : "Description"
          },
          "dmd_name" : {
            "$ref" : "#/$defs/SubjectFieldValidation",
            "description" : "DMD Name"
          },
          "dn_qualifier" : {
            "$ref" : "#/$defs/SubjectFieldValidation",
            "description" : "DN Qualifier"
          },
          "domain_component" : {
            "$ref" : "#/$defs/SubjectFieldValidation",
            "description" : "Domain Component"
          },
          "email" : {
            "$ref" : "#/$defs/SubjectFieldValidation",
            "description" : "Email"
          },
          "email_address" : {
            "$ref" : "#/$defs/SubjectFieldValidation",
            "description" : "Email Address"
          },
          "generation" : {
            "$ref" : "#/$defs/SubjectFieldValidation",
            "description" : "Generation"
          },
          "given_name" : {
            "$ref" : "#/$defs/SubjectFieldValidation",
            "description" : "Given Name"
          },
          "initials" : {
            "$ref" : "#/$defs/SubjectFieldValidation",
            "description" : "Initials"
          },
          "jurisdiction_country" : {
            "$ref" : "#/$defs/SubjectFieldValidation",
            "description" : "Jurisdiction Country"
          },
          "jurisdiction_locality" : {
            "$ref" : "#/$defs/SubjectFieldValidation",
            "description" : "Jurisdiction Locality"
          },
          "jurisdiction_state" : {
            "$ref" : "#/$defs/SubjectFieldValidation",
            "description" : "Jurisdiction State"
          },
          "locality" : {
            "$ref" : "#/$defs/SubjectFieldValidation",
            "description" : "Locality"
          },
          "name" : {
            "$ref" : "#/$defs/SubjectFieldValidation",
            "description" : "Name"
          },
          "organization" : {
            "$ref" : "#/$defs/SubjectFieldValidation",
            "description" : "Organization"
          },
          "organization_identifier" : {
            "$ref" : "#/$defs/SubjectFieldValidation",
            "description" : "Organization Identifier"
          },
          "organizational_unit" : {
            "$ref" : "#/$defs/SubjectFieldValidation",
            "description" : "Organizational Unit"
          },
          "postal_address" : {
            "$ref" : "#/$defs/SubjectFieldValidation",
            "description" : "Postal Address"
          },
          "postal_code" : {
            "$ref" : "#/$defs/SubjectFieldValidation",
            "description" : "Postal Code"
          },
          "pseudonym" : {
            "$ref" : "#/$defs/SubjectFieldValidation",
            "description" : "Pseudonym"
          },
          "role" : {
            "$ref" : "#/$defs/SubjectFieldValidation",
            "description" : "Role"
          },
          "serial_number" : {
            "$ref" : "#/$defs/SubjectFieldValidation",
            "description" : "Serial Number"
          },
          "serial_number_legacy" : {
            "$ref" : "#/$defs/SubjectFieldValidation",
            "description" : "Serial Number Legacy"
          },
          "state" : {
            "$ref" : "#/$defs/SubjectFieldValidation",
            "description" : "State"
          },
          "street" : {
            "$ref" : "#/$defs/SubjectFieldValidation",
            "description" : "Street"
          },
          "surname" : {
            "$ref" : "#/$defs/SubjectFieldValidation",
            "description" : "Surname"
          },
          "telephone_number" : {
            "$ref" : "#/$defs/SubjectFieldValidation",
            "description" : "Telephone Number"
          },
          "title" : {
            "$ref" : "#/$defs/SubjectFieldValidation",
            "description" : "Title"
          },
