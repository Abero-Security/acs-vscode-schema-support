{
  "name": "acs-vscode-schema-support",
  "displayName": "ACS YAML Schema Support",
  "description": "Adds YAML Schema Support to VSCode for Agile Certificate Services configuration files.",
  "version": "0.0.0",
  "publisher": "Abero-Security",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/Abero-Security/acs-vscode-schema-support.git"
  },
  "bugs": {
    "url": "https://github.com/Abero-Security/acs-vscode-schema-support/issues"
  },
  "homepage": "https://github.com/Abero-Security/acs-vscode-schema-support#readme",
  "qna": "marketplace",
  "engines": {
    "vscode": "^1.102.0"
  },
  "icon": "images/icon.png",
  "categories": [
    "Linters",
    "Programming Languages"
  ],
  "keywords": [
    "yaml",
    "schema",
    "validation",
    "acs",
    "certificate",
    "intellisense"
  ],
  "extensionDependencies": [
    "redhat.vscode-yaml"
  ],
  "contributes": {
    "yamlValidation": [
      {
        "fileMatch": [
          "*.certprofile.yml"
        ],
        "url": "./schemas/certificate-profile.schema.json"
      },
      {
        "fileMatch": [
          "*.caprofile.yml"
        ],
        "url": "./schemas/ca-profile.schema.json"
      },
      {
        "fileMatch": [
          "*.keystore.yml"
        ],
        "url": "./schemas/keystore.schema.json"
      }
    ]
  }
}